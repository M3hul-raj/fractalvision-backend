# Local development environment variables (copy to .env and fill as needed)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://fractalvision-frontend.vercel.app
DATABASE_URL=postgresql://fractalvision:fractalvision@localhost:5432/fractalvision
RATE_LIMIT_PER_MINUTE=60
ANALYSIS_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216
UPLOAD_READ_TIMEOUT_SECONDS=10.0
ANALYSIS_TIMEOUT_SECONDS=15.0

# Optional — only needed when running scripts/backfill_db.py or scripts/upload_images.py
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
